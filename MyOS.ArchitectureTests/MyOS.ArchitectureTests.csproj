    <ProjectReference Include="..\MyOS.Core.Domain\MyOS.Core.Domain.csproj" />
    <ProjectReference Include="..\MyOS.Core.Infrastructure\MyOS.Core.Infrastructure.csproj" />
    <ProjectReference Include="..\MyOS.Identity.Application\MyOS.Identity.Application.csproj" />
    <ProjectReference Include="..\MyOS.Identity.Domain\MyOS.Identity.Domain.csproj" />
    <ProjectReference Include="..\MyOS.Identity.Infrastructure\MyOS.Identity.Infrastructure.csproj" />
    <ProjectReference Include="..\MyOS.Modules.Notes.Application\MyOS.Modules.Notes.Application.csproj" />
    <ProjectReference Include="..\MyOS.Modules.Notes.Domain\MyOS.Modules.Notes.Domain.csproj" />
    <ProjectReference Include="..\MyOS.Modules.Notes.Infrastructure\MyOS.Modules.Notes.Infrastructure.csproj" />
    <ProjectReference Include="..\MyOS.Modules.Storage.Application\MyOS.Modules.Storage.Application.csproj" />
    <ProjectReference Include="..\MyOS.Modules.Storage.Domain\MyOS.Modules.Storage.Domain.csproj" />
    <ProjectReference Include="..\MyOS.Modules.Storage.Infrastructure\MyOS.Modules.Storage.Infrastructure.csproj" />
    <ProjectReference Include="..\MyOS.Modules.Fitness.Application\MyOS.Modules.Fitness.Application.csproj" />
    <ProjectReference Include="..\MyOS.Modules.Fitness.Domain\MyOS.Modules.Fitness.Domain.csproj" />
    <ProjectReference Include="..\MyOS.Modules.Fitness.Infrastructure\MyOS.Modules.Fitness.Infrastructure.csproj" />
